# NEVER commit real credentials.
ALPACA_API_KEY_ID=your_live_api_key_id
ALPACA_API_SECRET_KEY=your_live_api_secret
ALPACA_PAPER=false
TRADING_MODE=LIVE

# Safety defaults: keep these values until independently reviewed.
ENABLE_LIVE_ORDERS=false
DRY_RUN=true
EMERGENCY_STOP=true
MAX_ORDER_NOTIONAL=100
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=3

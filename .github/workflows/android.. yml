name: Build Android APK

on:
  workflow_dispatch:
    inputs:
      dashboard_url:
        description: "HTTPS URL of the deployed dashboard service"
        required: false
        type: string

  push:
    paths:
      - "app/**"
      - "build.gradle.kts"
      - "settings.gradle.kts"
      - "gradle.properties"
      - ".github/workflows/android.yml"

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Check out source
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.7"

      - name: Build debug APK
        env:
          DASHBOARD_URL: ${{ inputs.dashboard_url }}
        run: |
          gradle --no-daemon assembleDebug \
            -PDASHBOARD_URL="$DASHBOARD_URL"

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: alpaca-dashboard-debug-apk
          path: app/build/outputs/apk/debug/app-debug.apk
